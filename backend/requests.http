@baseUrl = http://localhost:3000

### Cadastro (público)
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nome": "Usuário Teste",
  "email": "teste@email.com",
  "senha": "123456"
}

### Login (gera o token salvo em @token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "teste@email.com",
  "senha": "123456"
}

@token = {{login.response.body.$.token}}

### Perfil do usuário logado (protegida)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Listar usuários (protegida - somente admin)
GET {{baseUrl}}/usuarios
Authorization: Bearer {{token}}

### Atualizar usuário (protegida - somente admin)
# Observação: o backend NÃO expõe GET /usuarios/:id nem DELETE /usuarios/:id.
# As únicas rotas de usuário existentes são GET /usuarios e PUT /usuarios/:id.
PUT {{baseUrl}}/usuarios/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Usuário Atualizado",
  "senha": "novaSenha123"
}
